{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "deno *": "allow",
      "rm *": "ask",
      "grep *": "allow"
    }
  },
  "mcp": {
    "next-devtools-mcp": {
      "type": "local",
      "command": ["deno", "run", "-A", "npm:next-devtools-mcp@latest"],
      "enabled": true
    },
    "tailwind-mcp": {
      "type": "local",
      "command": ["deno", "run", "-A", "npm:tailwindcss-mcp-server"],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["deno", "run", "-A", "npm:shadcn@latest", "mcp"],
      "enabled": true
    }
  }
}
